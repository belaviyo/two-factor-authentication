{
  "name": "2FA (Two-Factor Authentication)",
  "description": "Portable and Secure Two-Factor Authentication Using the Aegis Local Database",
  "version": "0.1.4",
  "manifest_version": 3,
  "offline_enabled": true,
  "homepage_url": "https://webextension.org/listing/2fa.html",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "icons": {
  },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "data/popup/index.html?mode=popup"
  },
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/256.png",
    "512": "data/icons/512.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
